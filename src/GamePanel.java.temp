    private void drawGameOverOverlay(Graphics2D g2) {
        drawDimRect(g2, 190);

        // Falling red orbs animation
        long t = System.currentTimeMillis();
        java.util.Random rng = new java.util.Random(7);
        for (int i = 0; i < 8; i++) {
            float px = rng.nextFloat() * screenWidth;
            float speed = 80 + rng.nextFloat() * 60;
            float py = ((t / 1000f) * speed + i * 120) % (screenHeight + 60) - 30;
            int alpha = (int)(180 * Math.max(0, 1 - py / screenHeight));
            g2.setColor(new Color(239, 68, 68, Math.max(0, alpha)));
            g2.fillOval((int)px - 18, (int)py - 18, 36, 36);
            // Glow ring
            g2.setColor(new Color(239, 68, 68, 60));
            g2.fillOval((int)px - 26, (int)py - 26, 52, 52);
        }

        g2.setFont(new Font("Arial", Font.BOLD, 66));
        FontMetrics fm = g2.getFontMetrics();
        String title = "GAME OVER";
        int tx = (screenWidth - fm.stringWidth(title)) / 2;
        g2.setColor(new Color(239, 68, 68));
        drawGlowText(g2, title, tx, screenHeight / 2 - 50, new Color(239, 68, 68), 12);

        g2.setFont(new Font("Arial", Font.BOLD, 22));
        drawGradientButton(g2, "Restart Level", (screenWidth-260)/2, screenHeight/2 + 20, 260, 46,
            new Color(234,179,8), new Color(161,98,7), new Color(253,224,71,200));
        drawGradientButton(g2, "Main Menu", (screenWidth-260)/2, screenHeight/2 + 78, 260, 46,
            new Color(220,38,38), new Color(153,27,27), new Color(252,165,165,200));
    }

    private void drawYouWinOverlay(Graphics2D g2) {
        drawDimRect(g2, 190);

        // Falling golden stars confetti
        long t = System.currentTimeMillis();
        java.util.Random rng = new java.util.Random(13);
        Color[] starColors = {new Color(250,204,21), new Color(254,240,138), new Color(253,224,71),
                              new Color(255,255,255), new Color(168,85,247)};
        for (int i = 0; i < 25; i++) {
            float startX = rng.nextFloat() * screenWidth;
            float speed = 60 + rng.nextFloat() * 80;
            float py = ((t / 1000f) * speed + i * 50) % (screenHeight + 40) - 20;
            float sway = (float)(Math.sin(t / 800.0 + i) * 20);
            float px = startX + sway;
            g2.setColor(starColors[i % starColors.length]);
            int sz = 4 + rng.nextInt(8);
            int[] xs = starPolygon((int)px, (int)py, sz, sz/2);
            int[] ys = starPolygonY((int)px, (int)py, sz, sz/2);
            g2.fillPolygon(xs, ys, 10);
        }

        // Trophy icon
        g2.setFont(new Font("Segoe UI Emoji", Font.PLAIN, 70));
        float trophy_bounce = (float)(Math.sin(t / 500.0) * 8);
        FontMetrics efm = g2.getFontMetrics();
        String trophy = "\uD83C\uDFC6";
        g2.drawString(trophy, (screenWidth - efm.stringWidth(trophy)) / 2, (int)(screenHeight/2 - 110 + trophy_bounce));

        g2.setFont(new Font("Arial", Font.BOLD, 64));
        FontMetrics fm = g2.getFontMetrics();
        String title = "YOU WIN!";
        int tx = (screenWidth - fm.stringWidth(title)) / 2;
        g2.setColor(new Color(250, 204, 21));
        drawGlowText(g2, title, tx, screenHeight / 2 - 30, new Color(250, 204, 21), 12);

        g2.setFont(new Font("Arial", Font.BOLD, 20)); g2.setColor(Color.WHITE);
        String sub = "All " + levelManager.getDifficulty().getTotalLevels() + " Levels Complete!";
        fm = g2.getFontMetrics();
        g2.drawString(sub, (screenWidth - fm.stringWidth(sub)) / 2, screenHeight / 2 + 20);

        g2.setFont(new Font("Arial", Font.BOLD, 22));
        drawGradientButton(g2, "Play Again", (screenWidth-260)/2, screenHeight/2 + 50, 260, 46,
            new Color(34,197,94), new Color(21,128,61), new Color(134,239,172,200));
        drawGradientButton(g2, "Main Menu", (screenWidth-260)/2, screenHeight/2 + 108, 260, 46,
            new Color(220,38,38), new Color(153,27,27), new Color(252,165,165,200));
    }

    private void drawLoginOverlay(Graphics2D g2) {
        drawDimRect(g2, 255);

        // Title with glow
        g2.setFont(new Font("Arial", Font.BOLD, 64));
        FontMetrics fm = g2.getFontMetrics();
        String title = "LOGIN";
        int titleX = (screenWidth - fm.stringWidth(title)) / 2;
        g2.setColor(Color.WHITE);
        drawGlowText(g2, title, titleX, 200, new Color(59, 130, 246), 10);

        // Label
        g2.setFont(new Font("Arial", Font.PLAIN, 20));
        fm = g2.getFontMetrics();
        String lbl = "Enter Username:";
        g2.setColor(new Color(200, 230, 255));
        g2.drawString(lbl, (screenWidth - fm.stringWidth(lbl)) / 2, screenHeight / 2 - 38);

        // Input box
        int tw = 320, th = 52, tx = (screenWidth - tw) / 2, ty = screenHeight / 2 - 22;
        g2.setColor(new Color(15, 20, 60, 200));
        g2.fillRoundRect(tx, ty, tw, th, 14, 14);
        // Cyan glow border
        long now = System.currentTimeMillis();
        float pulse = 0.6f + 0.4f * (float)Math.abs(Math.sin(now / 600.0));
        g2.setColor(new Color(34, 211, 238, (int)(pulse * 255)));
        g2.setStroke(new BasicStroke(3f));
        g2.drawRoundRect(tx, ty, tw, th, 14, 14);
        g2.setStroke(new BasicStroke(1f));

        g2.setColor(Color.WHITE);
        g2.setFont(new Font("Arial", Font.BOLD, 26));
        fm = g2.getFontMetrics();
        String inputText = loginInput.toString() + (now % 1000 < 500 ? "|" : "");
        g2.drawString(inputText, tx + (tw - fm.stringWidth(inputText)) / 2, ty + 34);

        // START GAME button - green gradient
        g2.setFont(new Font("Arial", Font.BOLD, 22));
        drawGradientButton(g2, "START GAME", (screenWidth - 280) / 2, screenHeight / 2 + 50, 280, 50,
            new Color(34, 197, 94), new Color(21, 128, 61), new Color(134, 239, 172, 200));

        // Animated bouncing bubbles at bottom
        int[] bColors = {0xef4444, 0x3b82f6, 0x22c55e, 0xeab308, 0x8b5cf6};
        int bCount = 5, bSize = 24, bSpacing = 50;
        int bStartX = screenWidth / 2 - (bCount * bSpacing) / 2;
        for (int i = 0; i < bCount; i++) {
            float bounce = (float)(Math.sin(now / 400.0 + i * 0.8) * 14);
            int bx = bStartX + i * bSpacing;
            int by2 = (int)(screenHeight - 70 + bounce);
            Color bc = new Color(bColors[i]);
            // Glow
            g2.setColor(new Color(bc.getRed(), bc.getGreen(), bc.getBlue(), 60));
            g2.fillOval(bx - 6, by2 - 6, bSize + 12, bSize + 12);
            // Ball
            g2.setColor(bc);
            g2.fillOval(bx, by2, bSize, bSize);
            // Highlight
            g2.setColor(new Color(255, 255, 255, 100));
            g2.fillOval(bx + 4, by2 + 4, bSize / 3, bSize / 3);
        }
    }

    private void drawLevelSelectOverlay(Graphics2D g2) {
        drawDimRect(g2, 230);

        // Title
        g2.setFont(new Font("Arial", Font.BOLD, 42));
        FontMetrics fm = g2.getFontMetrics();
        String title = "LEVEL SELECTION";
        int tx = (screenWidth - fm.stringWidth(title)) / 2;
        g2.setColor(Color.WHITE);
        drawGlowText(g2, title, tx, 100, new Color(59, 130, 246), 7);

        // Difficulty badge
        Difficulty diff = levelManager.getDifficulty();
        Color diffColor = diff == Difficulty.EASY ? new Color(34,197,94)
                        : diff == Difficulty.MEDIUM ? new Color(234,179,8)
                        : new Color(239,68,68);
        g2.setFont(new Font("Arial", Font.BOLD, 22));
        fm = g2.getFontMetrics();
        String diffName = diff.name();
        int dw = fm.stringWidth(diffName) + 30;
        int dx2 = (screenWidth - dw) / 2;
        g2.setColor(new Color(diffColor.getRed(), diffColor.getGreen(), diffColor.getBlue(), 60));
        g2.fillRoundRect(dx2, 112, dw, 28, 14, 14);
        g2.setColor(diffColor);
        g2.drawString(diffName, (screenWidth - fm.stringWidth(diffName)) / 2, 131);

        int cols = 5, padding = 20, startY = 155;
        int boxSize = (screenWidth - (cols + 1) * padding) / cols;

        int unlocked = levelManager.getCurrentUnlocked();
        int total = diff.getTotalLevels();

        for (int i = 0; i < total; i++) {
            int r = i / cols;
            int c = i % cols;
            int bx = padding + c * (boxSize + padding);
            int by = startY + r * (boxSize + padding);

            boolean lock = i >= unlocked;
            boolean hover = !lock && mouseX >= bx && mouseX <= bx + boxSize
                         && mouseY >= by && mouseY <= by + boxSize;

            // Fill
            if (lock) {
                g2.setColor(new Color(55, 65, 81));
            } else {
                GradientPaint gp = new GradientPaint(bx, by, diffColor,
                    bx + boxSize, by + boxSize,
                    diffColor.darker());
                g2.setPaint(gp);
            }
            g2.fillRoundRect(bx, by, boxSize, boxSize, 12, 12);
            g2.setPaint(null);

            // Top gleam for unlocked
            if (!lock) {
                g2.setColor(new Color(255, 255, 255, 40));
                g2.fillRoundRect(bx + 2, by + 2, boxSize - 4, boxSize / 2, 10, 10);
            }

            // Border
            g2.setStroke(new BasicStroke(hover ? 2.5f : 1.5f));
            g2.setColor(lock ? new Color(100, 116, 139) : new Color(255, 255, 255, 160));
            g2.drawRoundRect(bx, by, boxSize, boxSize, 12, 12);
            g2.setStroke(new BasicStroke(1f));

            if (lock) {
                g2.setFont(new Font("Segoe UI Emoji", Font.PLAIN, 22));
                drawCenteredInBox(g2, "\uD83D\uDD12", bx, by, boxSize);
            } else {
                g2.setFont(new Font("Arial", Font.BOLD, hover ? 26 : 22));
                g2.setColor(Color.WHITE);
                drawCenteredInBox(g2, String.valueOf(i + 1), bx, by, boxSize);
            }
        }

        g2.setFont(new Font("Arial", Font.BOLD, 22));
        drawGradientButton(g2, "BACK", (screenWidth - 260) / 2, screenHeight - 58, 260, 46,
            new Color(127, 29, 29), new Color(69, 10, 10), new Color(252, 165, 165, 180));
    }

