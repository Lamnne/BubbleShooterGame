    // ── Click detection helpers for revised button positions ──────────────────
    // NOTE: handleMenuClick still uses the old y coordinates; update them below.

    
    private void drawIntroOverlay(Graphics2D g2) {
        int alpha = (int) (220 * Math.min(1.0, introTimer / 30.0));
        drawDimRect(g2, alpha);
        g2.setFont(new Font("Arial", Font.BOLD, 72));
        g2.setColor(new Color(255, 255, 255, alpha));
        drawCentered(g2, introDifficulty, screenHeight / 2 + 10);
        g2.setStroke(new BasicStroke(4f));
        g2.setColor(new Color(255, 255, 255, alpha / 2));
        g2.drawLine(100, screenHeight / 2 + 30, screenWidth - 100, screenHeight / 2 + 30);
        g2.setStroke(new BasicStroke(1f));
    }
    
    private void drawButton(Graphics2D g2, String text, int y, Color color) {
        // Derive gradient colors from base color
        Color lighter = color.brighter();
        Color borderC = new Color(
            Math.min(255, color.getRed() + 80),
            Math.min(255, color.getGreen() + 80),
            Math.min(255, color.getBlue() + 80), 200);
        drawGradientButton(g2, text, (screenWidth - 250) / 2, y, 250, 44, color, lighter.darker(), borderC);
    }

    /** Draws a premium gradient button with glow border and hover scale */
    private void drawGradientButton(Graphics2D g2, String text, int x, int y, int w, int h,
                                     Color c1, Color c2, Color borderColor) {
        boolean hover = (mouseX >= x && mouseX <= x + w && mouseY >= y && mouseY <= y + h);
        double scale = hover ? (isDragging ? 0.93 : 1.07) : 1.0;
        int ty = hover && !isDragging ? y - 2 : y;

        java.awt.geom.AffineTransform old = g2.getTransform();
        g2.translate(x + w / 2.0, ty + h / 2.0);
        g2.scale(scale, scale);

        // Drop shadow
        g2.setColor(new Color(0, 0, 0, 80));
        g2.fillRoundRect(-w/2 + 2, -h/2 + 4, w, h, 14, 14);

        // Gradient fill
        GradientPaint gp = new GradientPaint(-w/2, 0, c1, w/2, 0, c2);
        g2.setPaint(gp);
        g2.fillRoundRect(-w/2, -h/2, w, h, 14, 14);
        g2.setPaint(null);

        // Inner highlight (top gleam)
        g2.setColor(new Color(255, 255, 255, 40));
        g2.fillRoundRect(-w/2 + 2, -h/2 + 2, w - 4, h / 2, 12, 12);

        // Border glow
        g2.setStroke(new BasicStroke(2.5f));
        g2.setColor(borderColor);
        g2.drawRoundRect(-w/2, -h/2, w, h, 14, 14);
        g2.setStroke(new BasicStroke(1f));

        // Text with shadow
        FontMetrics fm = g2.getFontMetrics();
        int tx = -fm.stringWidth(text) / 2;
        int tyl = fm.getAscent() - fm.getHeight() / 2;
        g2.setColor(new Color(0, 0, 0, 100));
        g2.drawString(text, tx + 1, tyl + 1);
        g2.setColor(Color.WHITE);
        g2.drawString(text, tx, tyl);

        g2.setTransform(old);
    }

    /** Draws text with a colored outer glow effect */
    private void drawGlowText(Graphics2D g2, String text, int x, int y, Color glowColor, int glowRadius) {
        java.awt.AlphaComposite ac = java.awt.AlphaComposite.getInstance(java.awt.AlphaComposite.SRC_OVER, 0.35f);
        java.awt.Composite oldComp = g2.getComposite();
        g2.setComposite(ac);
        g2.setColor(glowColor);
        for (int r = glowRadius; r >= 1; r -= 2) {
            for (int dx = -r; dx <= r; dx += r) {
                for (int dy = -r; dy <= r; dy += r) {
                    g2.drawString(text, x + dx, y + dy);
                }
            }
        }
        g2.setComposite(oldComp);
        g2.drawString(text, x, y);
    }

    private void drawLevelClearOverlay(Graphics2D g2, int levelNum) {
        drawDimRect(g2, 180);

        // Animated stars / confetti using time
        long t = System.currentTimeMillis();
        java.util.Random rng = new java.util.Random(42);
        for (int i = 0; i < 18; i++) {
            float px = rng.nextFloat() * screenWidth;
            float baseY = rng.nextFloat() * screenHeight;
            float speed = 60 + rng.nextFloat() * 80;
            float py = (baseY + (t / 1000f) * speed) % screenHeight;
            Color[] cc = {new Color(250,204,21), new Color(34,197,94), new Color(59,130,246),
                          new Color(239,68,68), new Color(168,85,247)};
            g2.setColor(cc[i % cc.length]);
            int sz = 6 + rng.nextInt(8);
            g2.fillOval((int)px - sz/2, (int)py - sz/2, sz, sz);
        }

        // Title with star icons + glow
        g2.setFont(new Font("Arial", Font.BOLD, 46));
        FontMetrics fm = g2.getFontMetrics();
        String title = "\u2B50 Level " + levelNum + " Clear! \u2B50";
        int tx = (screenWidth - fm.stringWidth(title)) / 2;
        g2.setColor(new Color(250, 204, 21));
        drawGlowText(g2, title, tx, screenHeight / 2 - 70, new Color(250, 204, 21), 10);

        g2.setFont(new Font("Arial", Font.BOLD, 22));
        if (levelManager.hasNext()) {
            drawGradientButton(g2, "Next Level", (screenWidth-260)/2, screenHeight/2 + 10, 260, 46,
                new Color(34,197,94), new Color(21,128,61), new Color(134,239,172,200));
        }
        drawGradientButton(g2, "Restart Level", (screenWidth-260)/2, screenHeight/2 + 68, 260, 46,
            new Color(234,179,8), new Color(161,98,7), new Color(253,224,71,200));
        drawGradientButton(g2, "Main Menu", (screenWidth-260)/2, screenHeight/2 + 126, 260, 46,
            new Color(220,38,38), new Color(153,27,27), new Color(252,165,165,200));
    }

