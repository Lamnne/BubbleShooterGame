    private void drawDuoMode(Graphics2D g2) {
        // Left side (P1)
        drawDuoPlayer(g2, 0, world, shooter, animationManager, movingBall, duoWinsP1, levelManager, 1);
        // Right side (P2)
        drawDuoPlayer(g2, 300, world2, shooter2, animationManager2, movingBall2, duoWinsP2, levelManager2, 2);

        // Middle divider with gradient
        java.awt.LinearGradientPaint divGrad = new java.awt.LinearGradientPaint(
            300, 0, 300, screenHeight,
            new float[]{0f, 0.5f, 1f},
            new Color[]{new Color(59,130,246,0), new Color(255,255,255,200), new Color(59,130,246,0)});
        g2.setPaint(divGrad);
        g2.setStroke(new BasicStroke(3f));
        g2.drawLine(300, 0, 300, screenHeight);
        g2.setPaint(null);
        g2.setStroke(new BasicStroke(1f));

        // Bottom Buttons - gradient styled
        int bw = 120, bh = 40, by = screenHeight - 58;
        int backX = 165, restartX = 315;
        g2.setFont(new Font("Arial", Font.BOLD, 14));

        // Save/restore transform for each button
        java.awt.geom.AffineTransform savedT = g2.getTransform();
        // BACK
        boolean hoverBack = mouseX >= backX && mouseX <= backX + bw && mouseY >= by && mouseY <= by + bh;
        g2.translate(backX + bw/2.0, by + bh/2.0);
        g2.scale(hoverBack ? 1.07 : 1.0, hoverBack ? 1.07 : 1.0);
        g2.setColor(new Color(0,0,0,70)); g2.fillRoundRect(-bw/2+2, -bh/2+3, bw, bh, 12, 12);
        GradientPaint gpBack = new GradientPaint(-bw/2, 0, new Color(153,27,27), bw/2, 0, new Color(127,29,29));
        g2.setPaint(gpBack); g2.fillRoundRect(-bw/2, -bh/2, bw, bh, 12, 12); g2.setPaint(null);
        g2.setColor(new Color(252,165,165,180)); g2.setStroke(new BasicStroke(2f)); g2.drawRoundRect(-bw/2, -bh/2, bw, bh, 12, 12); g2.setStroke(new BasicStroke(1f));
        g2.setColor(Color.WHITE);
        FontMetrics fm2 = g2.getFontMetrics();
        g2.drawString("BACK", -fm2.stringWidth("BACK")/2, fm2.getAscent()-fm2.getHeight()/2);
        g2.setTransform(savedT);

        // RESTART
        boolean hoverRst = mouseX >= restartX && mouseX <= restartX + bw && mouseY >= by && mouseY <= by + bh;
        g2.translate(restartX + bw/2.0, by + bh/2.0);
        g2.scale(hoverRst ? 1.07 : 1.0, hoverRst ? 1.07 : 1.0);
        g2.setColor(new Color(0,0,0,70)); g2.fillRoundRect(-bw/2+2, -bh/2+3, bw, bh, 12, 12);
        GradientPaint gpRst = new GradientPaint(-bw/2, 0, new Color(249,115,22), bw/2, 0, new Color(220,38,38));
        g2.setPaint(gpRst); g2.fillRoundRect(-bw/2, -bh/2, bw, bh, 12, 12); g2.setPaint(null);
        g2.setColor(new Color(254,215,170,180)); g2.setStroke(new BasicStroke(2f)); g2.drawRoundRect(-bw/2, -bh/2, bw, bh, 12, 12); g2.setStroke(new BasicStroke(1f));
        g2.setColor(Color.WHITE);
        g2.drawString("RESTART", -fm2.stringWidth("RESTART")/2, fm2.getAscent()-fm2.getHeight()/2);
        g2.setTransform(savedT);
    }

    private void drawDuoPlayer(Graphics2D g2, int offsetX, BallWorld w, Shooter s, AnimationManager am, Ball mb, int wins, LevelManager lm, int playerNum) {
        java.awt.geom.AffineTransform old = g2.getTransform();
        g2.translate(offsetX, 0);

        // Ceiling panel (glassmorphism)
        g2.setColor(new Color(0, 0, 0, 120));
        g2.fillRect(0, 0, 300, (int) w.getCeilingY());

        // Balls, animations, moving ball
        for (Ball b : w.getBalls()) b.draw(g2);
        am.draw(g2);
        if (mb != null) mb.draw(g2);

        // Shooter & Aiming Arrow
        s.draw(g2);
        drawAimingArrowDuo(g2, s, s == shooter ? sweepAngle : sweepAngle2);

        // Player label at top
        Color pColor = playerNum == 1 ? new Color(59, 130, 246) : new Color(249, 115, 22);
        g2.setColor(new Color(0, 0, 0, 100));
        g2.fillRoundRect(70, 36, 160, 30, 12, 12);
        g2.setStroke(new BasicStroke(1.5f));
        g2.setColor(new Color(pColor.getRed(), pColor.getGreen(), pColor.getBlue(), 160));
        g2.drawRoundRect(70, 36, 160, 30, 12, 12);
        g2.setStroke(new BasicStroke(1f));
        g2.setFont(new Font("Arial", Font.BOLD, 16));
        FontMetrics fm = g2.getFontMetrics();
        String pLabel = "PLAYER " + playerNum;
        g2.setColor(pColor);
        g2.drawString(pLabel, (300 - fm.stringWidth(pLabel)) / 2, 56);

        // Stats at bottom
        g2.setColor(new Color(0, 0, 0, 100));
        g2.fillRect(0, screenHeight - 80, 300, 30);
        g2.setFont(new Font("Arial", Font.BOLD, 14));
        g2.setColor(new Color(200, 220, 255));
        g2.drawString("Level: " + (lm.getCurrentIndex() + 1), 10, screenHeight - 60);
        g2.setColor(new Color(250, 204, 21));
        g2.drawString("Wins: " + wins + " / 15", 160, screenHeight - 60);

        g2.setTransform(old);
    }

    private void drawAimingArrowDuo(Graphics2D g2, Shooter s, double angle) {
        double curX = s.getX();
        double curY = s.getY();
        double ux = Math.sin(angle);
        double uy = -Math.cos(angle);
        
        double totalLen = screenHeight * 0.6;
        double traveled = 0;
        int step = 15;
        
        while (traveled < totalLen) {
            double nextStep = Math.min(step, totalLen - traveled);
            
            // Check for wall hit (local width is 300)
            double tWall = Double.MAX_VALUE;
            if (ux < -1e-9) tWall = (0 - curX) / ux;
            else if (ux > 1e-9) tWall = (300 - curX) / ux;
            
            if (tWall < nextStep) {
                // Segment hits wall
                double x2 = curX + ux * tWall;
                double y2 = curY + uy * tWall;
                float ratio = (float) traveled / (float) totalLen;
                int alpha = (int) (180 * (1.0f - ratio));
                g2.setColor(new Color(255, 255, 255, alpha));
                g2.setStroke(new BasicStroke(2.5f));
                g2.drawLine((int)curX, (int)curY, (int)x2, (int)y2);
                
                ux = -ux; // Reflect
                curX = x2;
                curY = y2;
                traveled += tWall;
            } else {
                // Straight segment
                double x2 = curX + ux * nextStep;
                double y2 = curY + uy * nextStep;
                float ratio = (float) traveled / (float) totalLen;
                int alpha = (int) (180 * (1.0f - ratio));
                g2.setColor(new Color(255, 255, 255, alpha));
                g2.setStroke(new BasicStroke(2.5f));
                g2.drawLine((int)curX, (int)curY, (int)x2, (int)y2);
                
                curX = x2;
                curY = y2;
                traveled += nextStep;
            }
        }
    }

    private void drawCenteredInBox(Graphics2D g2, String text, int bx, int by, int size) {
        FontMetrics fm = g2.getFontMetrics();
        g2.drawString(text, bx + (size - fm.stringWidth(text)) / 2, by + (size + fm.getAscent() / 2) / 2);
    }

    private void drawDuoWin(Graphics2D g2, int p) {
        drawDimRect(g2, 200);

        // Confetti
        long t = System.currentTimeMillis();
        java.util.Random rng = new java.util.Random(p * 31);
        Color[] confettiColors = {new Color(239,68,68), new Color(59,130,246), new Color(34,197,94),
                                   new Color(234,179,8), new Color(168,85,247), new Color(255,255,255)};
        for (int i = 0; i < 40; i++) {
            float sx = rng.nextFloat() * screenWidth;
            float speed = 70 + rng.nextFloat() * 80;
            float py = ((t / 1000f) * speed + i * 40) % (screenHeight + 30) - 15;
            float sway = (float)(Math.sin(t / 700.0 + i) * 18);
            g2.setColor(confettiColors[i % confettiColors.length]);
            int sz = 5 + rng.nextInt(7);
            g2.fillOval((int)(sx + sway) - sz/2, (int)py - sz/2, sz, sz);
        }

        // Trophy
        g2.setFont(new Font("Segoe UI Emoji", Font.PLAIN, 72));
        float tb = (float)(Math.sin(t / 450.0) * 10);
        FontMetrics efm = g2.getFontMetrics();
        String trophy = "\uD83C\uDFC6";
        g2.drawString(trophy, (screenWidth - efm.stringWidth(trophy)) / 2, (int)(screenHeight / 2 - 110 + tb));

        // Title
        g2.setFont(new Font("Arial", Font.BOLD, 58));
        FontMetrics fm = g2.getFontMetrics();
        Color titleColor = p == 1 ? new Color(103, 232, 249) : new Color(251, 146, 60);
        String winText = "PLAYER " + p + " WINS!";
        int wtx = (screenWidth - fm.stringWidth(winText)) / 2;
        g2.setColor(titleColor);
        drawGlowText(g2, winText, wtx, screenHeight / 2 - 20, titleColor, 10);

        // Sub text
        g2.setFont(new Font("Arial", Font.BOLD, 20));
        fm = g2.getFontMetrics();
        g2.setColor(Color.WHITE);
        String sub = "Congratulations!";
        g2.drawString(sub, (screenWidth - fm.stringWidth(sub)) / 2, screenHeight / 2 + 20);

        g2.setFont(new Font("Arial", Font.BOLD, 22));
        drawGradientButton(g2, "Play Again", (screenWidth - 260) / 2, screenHeight / 2 + 55, 260, 46,
            new Color(34,197,94), new Color(21,128,61), new Color(134,239,172,200));
        drawGradientButton(g2, "Main Menu", (screenWidth - 260) / 2, screenHeight / 2 + 113, 260, 46,
            new Color(220,38,38), new Color(153,27,27), new Color(252,165,165,200));
    }

    private void drawCentered(Graphics2D g2, String text, int y) {
        FontMetrics fm = g2.getFontMetrics();
        g2.drawString(text, (screenWidth - fm.stringWidth(text)) / 2, y);
    }

    private void drawDimRect(Graphics2D g2, int alpha) {
        g2.setColor(new Color(0, 0, 0, alpha)); g2.fillRect(0, 0, screenWidth, screenHeight);
    }

    /** Returns x-coords of a 5-pointed star polygon centered at (cx,cy) */
    private int[] starPolygon(int cx, int cy, int outerR, int innerR) {
        int[] xs = new int[10];
        for (int i = 0; i < 10; i++) {
            double angle = Math.PI / 5 * i - Math.PI / 2;
            int r = (i % 2 == 0) ? outerR : innerR;
            xs[i] = cx + (int)(Math.cos(angle) * r);
        }
        return xs;
    }

    /** Returns y-coords of a 5-pointed star polygon centered at (cx,cy) */
    private int[] starPolygonY(int cx, int cy, int outerR, int innerR) {
        int[] ys = new int[10];
        for (int i = 0; i < 10; i++) {
            double angle = Math.PI / 5 * i - Math.PI / 2;
            int r = (i % 2 == 0) ? outerR : innerR;
            ys[i] = cy + (int)(Math.sin(angle) * r);
        }
        return ys;
    }
    
    private void drawMuteButton(Graphics2D g2, int x, int y) {
        boolean muted = SoundManager.isMuted();
        g2.setColor(Color.WHITE); g2.fillRect(x, y + 4, 6, 8);
        int[] px = {x + 6, x + 15, x + 15}, py = {y + 4, y, y + 16};
        g2.fillPolygon(px, py, 3);
        if (muted) {
            g2.setStroke(new BasicStroke(2f)); g2.setColor(new Color(255, 50, 50));
            g2.drawLine(x + 18, y + 4, x + 26, y + 12); g2.drawLine(x + 26, y + 4, x + 18, y + 12);
        } else {
            g2.setStroke(new BasicStroke(1.5f)); g2.drawArc(x + 12, y + 2, 8, 12, -45, 90); g2.drawArc(x + 15, y - 2, 12, 20, -45, 90);
        }
        g2.setStroke(new BasicStroke(1f));
    }
}
